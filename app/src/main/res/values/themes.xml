<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GreggoryPortal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background of the splash screen -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- Icon to be shown in the center of the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Background for the icon (optional) -->
        <!-- <item name="windowSplashScreenIconBackgroundColor">#FFFFFF</item> -->
        <!-- Theme to be used after the splash screen is done -->
        <item name="postSplashScreenTheme">@style/Theme.GreggoryPortal</item>
    </style>
</resources>
