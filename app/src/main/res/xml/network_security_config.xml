<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted ONLY for the emulator's loopback alias (10.0.2.2),
  which maps to the developer machine running the local backend during testing.
  Every other domain (including the Render cloud in release) stays HTTPS-only,
  so production traffic is never downgraded.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>